# --- Postgres (required). Needs the pgvector extension (Neon / Supabase / pgvector docker image) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research

# --- Gemini (required: embeddings + chat + extraction) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# MUST match the pgvector column dimension (fixed when the chunks table is first created).
# pgvector's `vector` type maxes out at 2000 dims; Gemini supports 768 / 1536 / 3072.
GEMINI_EMBEDDING_DIM=1536

# Model routing: ordered fallbacks per tier (light: extraction/contradictions,
# standard: chat/gap analysis, strong: review writing). Optional per-task override:
# TASK_ROUTES=chat=light,write=standard
GEMINI_LIGHT_MODELS=gemini-flash-lite-latest,gemini-flash-latest
GEMINI_STANDARD_MODELS=gemini-flash-latest,gemini-flash-lite-latest
GEMINI_STRONG_MODELS=gemini-pro-latest,gemini-flash-latest

# --- S3-compatible storage for PDFs (optional in dev: blank = local disk) ---
# Cloudflare R2: S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com  S3_REGION=auto
# Local MinIO (docker compose): S3_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Redis (optional): answer cache (exact + semantic) and LLM response cache. Blank = no caching. ---
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_THRESHOLD=0.93

# --- Retrieval: dense (pgvector) + keyword (Postgres full-text), fused with RRF ---
HYBRID_SEARCH=true

# --- Deployment ---
# APP_ENV=production refuses to start without Firebase auth and a real CORS_ORIGINS.
APP_ENV=development
CORS_ORIGINS=*

# --- Firebase Auth (end-user login). Blank = DEV MODE: bearer token is treated as the uid. ---
FIREBASE_SERVICE_ACCOUNT_PATH=
